# kb configuration. Copy to .env (scripts/macos-setup.sh does this and fills in random secrets).
# Read by docker compose (env_file + interpolation), by the justfile (dotenv-load) and by
# scripts/*.sh, so keep it bash-compatible: KEY=value, quote values containing spaces/brackets.
#
# Model URLs point at host.docker.internal because the API and workers run in containers while
# the model servers run natively (Metal). Host-side processes (`just dev`, native install) get
# the same URLs rewritten to 127.0.0.1 by scripts/run-native.sh.
# Defaults below suit a 32 GB Mac mini; see deploy/README.md for 16/24/64 GB.

# ===== Deployment (compose / scripts; not read by the app) =====================================
POSTGRES_PASSWORD=change-me
# Hostname Caddy serves with its internal CA (add it to your LAN DNS or clients' /etc/hosts).
KB_DOMAIN=kb.local
# KB_IMAGE=kb:local
KB_WORKER_REPLICAS=2
# KB_PG_PORT=5432
# Postgres memory (the container VM needs ~2x shared_buffers + headroom). 16 GB Mac: 1GB/3GB.
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_MAINTENANCE_WORK_MEM=1GB
# PG_WORK_MEM=32MB
# PG_MAX_CONNECTIONS=200
# PG_MAX_WAL_SIZE=4GB
# Ollama context window (rendered into the com.kb.ollama LaunchAgent by macos-setup.sh).
OLLAMA_CONTEXT_LENGTH=32768
# Model downloads (macos-setup.sh). The reranker conversion MUST keep the classification head.
# KB_EMBED_GGUF_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
# KB_RERANK_GGUF_REPO=ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF

# ===== Backups (scripts/backup.sh, nightly via com.kb.backup) ==================================
# KB_BACKUP_DIR=/Users/you/.kb/backups      # default ~/.kb/backups
KB_BACKUP_KEEP_DAILY=7
KB_BACKUP_KEEP_WEEKLY=4
# Dead-man's switch, e.g. https://hc-ping.com/<uuid> (pinged on success, <url>/fail on error).
# KB_BACKUP_PING_URL=
# Offsite/encrypted copies with restic (external SSD path, s3:..., b2:...). Unset = skip.
# RESTIC_REPOSITORY=/Volumes/Backup/kb-restic
# RESTIC_PASSWORD_FILE=/Users/you/.kb/restic-password

# ===== Service ===================================================================================
KB_ENV=prod
# Bind address/port of the API (the container image sets 0.0.0.0; compose publishes 127.0.0.1 only).
# KB_HOST=127.0.0.1
# KB_PORT=8787
# Uvicorn worker processes for the API.
KB_WORKERS=2
# Bearer token for write endpoints and MCP. Empty = open: only acceptable on localhost.
KB_API_TOKEN=change-me
# Browser origins allowed by CORS (JSON list). Same-origin through Caddy needs no entry.
KB_CORS_ORIGINS='["http://localhost:5173"]'
# Built SPA directory (the image sets /app/static).
# KB_STATIC_DIR=../frontend/dist
KB_LOG_LEVEL=INFO
KB_LOG_JSON=true

# ===== Database ==================================================================================
# Compose builds this from POSTGRES_PASSWORD (host "db"); host-side tools use 127.0.0.1.
# KB_DATABASE_URL=postgresql://kb:change-me@db:5432/kb
KB_DB_POOL_MIN=2
KB_DB_POOL_MAX=16
KB_DB_STATEMENT_TIMEOUT_MS=15000

# ===== Ingestion =================================================================================
# Concurrent jobs per worker container (total = this x KB_WORKER_REPLICAS).
KB_WORKER_CONCURRENCY=4
KB_JOB_MAX_ATTEMPTS=5
# A job not finished within this many seconds is re-leased to another worker.
KB_JOB_LEASE_SECONDS=300
KB_CHUNK_TARGET_TOKENS=384
KB_CHUNK_OVERLAP_TOKENS=48
KB_MAX_UPLOAD_MB=100
# LLM-written "situating context" per chunk (Contextual Retrieval). Better recall, much slower ingest.
KB_CONTEXTUAL_CHUNKS=false

# ===== Embeddings (llama-server :8081, Qwen3-Embedding-0.6B) =====================================
KB_EMBEDDING_PROVIDER=openai
KB_EMBEDDING_BASE_URL=http://host.docker.internal:8081/v1
KB_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# KB_EMBEDDING_API_KEY=
# Changing the dimension requires re-creating the database (it is baked into the schema).
KB_EMBEDDING_DIM=1024
KB_EMBEDDING_BATCH_SIZE=32
# KB_EMBEDDING_QUERY_INSTRUCTION= (default: the Qwen3 "Instruct: ... Query: " retrieval prefix)

# ===== Reranking (llama-server :8082, Qwen3-Reranker-0.6B) =======================================
# llamacpp | llm | none | fake
KB_RERANK_PROVIDER=llamacpp
KB_RERANK_BASE_URL=http://host.docker.internal:8082/v1
KB_RERANK_MODEL=Qwen3-Reranker-0.6B
# Optional second, LLM-judged rerank over the cross-encoder's top N.
KB_LLM_RERANK=false
KB_LLM_RERANK_TOP_N=20

# ===== Chat / agent (Ollama :11434) ==============================================================
# openai (any OpenAI-compatible server) | anthropic | fake
KB_LLM_PROVIDER=openai
KB_LLM_BASE_URL=http://host.docker.internal:11434/v1
KB_LLM_MODEL=qwen3.5:9b
KB_LLM_ROUTER_MODEL=qwen3.5:4b
# KB_LLM_API_KEY=
# Optional cloud engine for /api/ask with engine=cloud.
# KB_ANTHROPIC_API_KEY=
KB_ANTHROPIC_MODEL=claude-haiku-5-5
KB_AGENT_MAX_STEPS=4
# Wall-clock budget for one /api/ask.
KB_AGENT_TIMEOUT_S=90
# Request non-thinking mode from local Qwen3.x servers (faster; steps are schema-constrained).
KB_LLM_DISABLE_THINKING=true

# ===== Search defaults ===========================================================================
KB_SEARCH_CANDIDATES=100
KB_RRF_K=60
KB_RERANK_CANDIDATES=50
KB_DEFAULT_LIMIT=10

# ===== Resilience ================================================================================
KB_MODEL_TIMEOUT_S=30
KB_BREAKER_FAILURES=3
KB_BREAKER_RESET_S=30
